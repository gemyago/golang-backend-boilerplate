{
  "database": {
    "dsn": "./data/app.db"
  },
  "petstore": {
    "baseURL": "https://petstore3.swagger.io/api/v3"
  },
  "defaultLogLevel": "INFO",
  "gracefulShutdownTimeout": "10s",
  "httpServer": {
    "host": "[::]",
    "port": 8080,
    "idleTimeout": "60s",
    "readHeaderTimeout": "2s",
    "readTimeout": "2s",
    "writeTimeout": "8s",
    "accessLogsLevel": ""
  },
  "mcpServer": {
    "name": "golang-backend-boilerplate-mcp",
    "version": "1.0.0",
    "httpHost": "localhost",
    "httpPort": 8080
  }
}